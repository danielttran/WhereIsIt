<Window
    x:Class="WhereIsIt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WhereIsIt.App.ViewModels"
    xmlns:app="using:WhereIsIt.App"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="WhereIsIt">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="0">
        <Grid.Resources>
            <Style x:Key="ColumnHeaderButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </Grid.Resources>

        <!-- Menu bar (Everything-style: File / Edit / Search / Bookmarks / View / Tools / Help) -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutSubItem Text="Export results to…">
                    <MenuFlyoutItem Text="CSV…" Click="OnExportCsvClick"/>
                    <MenuFlyoutItem Text="TSV…" Click="OnExportTsvClick"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="OnExitClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu" Key="F4"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Open" Click="OnOpenClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open containing folder" Click="OnOpenFolderClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Copy name" Click="OnCopyNameClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy full path" Click="OnCopyPathClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Search">
                <ToggleMenuFlyoutItem Text="Match case"
                    IsChecked="{x:Bind ViewModel.SearchBox.MatchCase, Mode=TwoWay}"/>
                <ToggleMenuFlyoutItem Text="Regex"
                    IsChecked="{x:Bind ViewModel.SearchBox.UseRegex,  Mode=TwoWay}"/>
                <ToggleMenuFlyoutItem Text="Match whole word"
                    IsChecked="{x:Bind ViewModel.SearchBox.WholeWord, Mode=TwoWay}"/>
                <ToggleMenuFlyoutItem Text="Match path"
                    IsChecked="{x:Bind ViewModel.SearchBox.MatchPath, Mode=TwoWay}"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem Text="Quick filter">
                    <MenuFlyoutItem Text="Everything"  Tag="all:"    Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Audio"       Tag="audio:"  Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Video"       Tag="video:"  Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Document"    Tag="doc:"    Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Picture"     Tag="pic:"    Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Executable"  Tag="exe:"    Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Compressed"  Tag="zip:"    Click="OnFilterClick"/>
                    <MenuFlyoutItem Text="Folder"      Tag="folder:" Click="OnFilterClick"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Focus search box" Click="OnFocusSearchClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Clear search" Click="OnClearSearchClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="New tab" Click="OnNewTabClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="T"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Close tab" Click="OnCloseTabClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Name="BookmarksMenu" Title="Bookmarks">
                <MenuFlyoutItem Text="Save current search…" Click="OnSaveBookmarkClick"/>
                <MenuFlyoutSeparator/>
                <!-- Dynamic bookmarks are inserted here at runtime. -->
            </MenuBarItem>

            <MenuBarItem Title="View">
                <MenuFlyoutSubItem Text="Columns">
                    <ToggleMenuFlyoutItem x:Name="ColCreatedItem"  Text="Created"  Click="OnColumnToggleClick"/>
                    <ToggleMenuFlyoutItem x:Name="ColAccessedItem" Text="Accessed" Click="OnColumnToggleClick"/>
                    <ToggleMenuFlyoutItem x:Name="ColRunsItem"     Text="Runs"     Click="OnColumnToggleClick"/>
                </MenuFlyoutSubItem>
            </MenuBarItem>

            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Options…" Click="OnSettingsClick"/>
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About WhereIsIt…" Click="OnAboutClick"/>
            </MenuBarItem>
        </MenuBar>

        <!-- Search box -->
        <TextBox Grid.Row="1"
                 x:Name="SearchTextBox"
                 Margin="12,8,12,4"
                 PlaceholderText="Search files and folders   (Ctrl+F focus, Esc clear, ↑/↓ history)"
                 KeyDown="OnSearchBoxKeyDown"
                 Text="{x:Bind ViewModel.SearchBox.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Tab strip -->
        <muxc:TabView Grid.Row="2"
                      x:Name="TabStrip"
                      TabItemsSource="{x:Bind ViewModel.Tabs.Tabs, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Tabs.CurrentTab, Mode=TwoWay}"
                      AddTabButtonClick="OnAddTabClick"
                      TabCloseRequested="OnTabCloseRequested"
                      Padding="12,0,12,0">
            <muxc:TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:TabRecord">
                    <muxc:TabViewItem Header="{x:Bind Title, Mode=OneWay}"/>
                </DataTemplate>
            </muxc:TabView.TabItemTemplate>
        </muxc:TabView>

        <!-- Results -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" Padding="12,0,12,0">
            <!-- Column headers -->
            <Grid Grid.Row="0"
                  x:Name="HeaderGrid"
                  BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <!-- column indexes 4,5,6 are toggleable (Created/Accessed/Runs) -->
                    <ColumnDefinition Width="{x:Bind app:ColumnSettings.CreatedColumnWidth,  Mode=OneTime}"/>
                    <ColumnDefinition Width="{x:Bind app:ColumnSettings.AccessedColumnWidth, Mode=OneTime}"/>
                    <ColumnDefinition Width="{x:Bind app:ColumnSettings.RunCountColumnWidth, Mode=OneTime}"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButton}"
                        Command="{x:Bind ViewModel.ResultsList.SortByCommand}" CommandParameter="name">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="Name" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ResultsList.NameSortIndicator, Mode=OneWay}" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}"
                        Command="{x:Bind ViewModel.ResultsList.SortByCommand}" CommandParameter="path">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="Path" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ResultsList.PathSortIndicator, Mode=OneWay}" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}"
                        Width="120" HorizontalContentAlignment="Right"
                        Command="{x:Bind ViewModel.ResultsList.SortByCommand}" CommandParameter="size">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="Size" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ResultsList.SizeSortIndicator, Mode=OneWay}" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}"
                        Width="160"
                        Command="{x:Bind ViewModel.ResultsList.SortByCommand}" CommandParameter="modified">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="Modified" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.ResultsList.ModifiedSortIndicator, Mode=OneWay}" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}"
                        Content="Created"
                        Visibility="{x:Bind app:ColumnSettings.CreatedColumnVisibility,  Mode=OneTime}"/>
                <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButton}"
                        Content="Accessed"
                        Visibility="{x:Bind app:ColumnSettings.AccessedColumnVisibility, Mode=OneTime}"/>
                <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButton}"
                        Content="Runs"
                        Visibility="{x:Bind app:ColumnSettings.RunCountColumnVisibility, Mode=OneTime}"/>
                <Button Grid.Column="7" Style="{StaticResource ColumnHeaderButton}"
                        Width="80"
                        Content="Attr"/>
            </Grid>

            <!-- Empty state overlay -->
            <Border Grid.Row="1"
                    Visibility="{x:Bind app:Converters.WhenNonEmpty(ViewModel.EmptyStateMessage), Mode=OneWay}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <TextBlock Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                           FontSize="16" Opacity="0.4"/>
            </Border>

            <ListView Grid.Row="1"
                      x:Name="ResultsListView"
                      ItemsSource="{x:Bind ViewModel.ResultsList.Rows, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.ResultsList.SelectedRow, Mode=TwoWay}"
                      SelectionMode="Extended"
                      DoubleTapped="OnRowDoubleTapped"
                      KeyDown="OnResultsKeyDown"
                      CanDragItems="True"
                      DragItemsStarting="OnDragItemsStarting"
                      ContainerContentChanging="OnContainerContentChanging">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open" Click="OnOpenClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Open containing folder" Click="OnOpenFolderClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Copy name" Click="OnCopyNameClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="C"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy full path" Click="OnCopyPathClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="C"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultRowViewModel">
                        <Grid Padding="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="{x:Bind app:ColumnSettings.CreatedColumnWidth,  Mode=OneTime}"/>
                                <ColumnDefinition Width="{x:Bind app:ColumnSettings.AccessedColumnWidth, Mode=OneTime}"/>
                                <ColumnDefinition Width="{x:Bind app:ColumnSettings.RunCountColumnWidth, Mode=OneTime}"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ParentPath, Mode=OneWay}"
                                       Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText, Mode=OneWay}" Opacity="0.7"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind CreatedText,  Mode=OneWay}" Opacity="0.55"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind AccessedText, Mode=OneWay}" Opacity="0.55"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind RunCount, Mode=OneWay}"
                                       HorizontalAlignment="Right" Opacity="0.55"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind AttributesText, Mode=OneWay}" Opacity="0.6"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Padding="12,6"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusBar.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.StatusBar.CountSummaryText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Opacity="0.7"/>
        </Grid>
    </Grid>
</Window>
