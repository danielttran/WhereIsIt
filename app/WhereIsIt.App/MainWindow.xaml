<Window
    x:Class="WhereIsIt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhereIsIt">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBox Grid.Row="0" PlaceholderText="Search..." Text="{x:Bind ViewModel.SearchBox.Query, Mode=TwoWay}" Margin="8" />
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ResultsList.Rows}" Margin="8,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding ParentPath}" Foreground="Gray" />
                        <TextBlock Text="{Binding SizeText}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusBar.StatusText, Mode=OneWay}" Margin="8" />
    </Grid>
</Window>
