<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>WhereIsIt.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>MVVMTK0045</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\WhereIsIt.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\WhereIsIt.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhereIsIt.App.Core\WhereIsIt.App.Core.csproj" />
  </ItemGroup>
  <!-- Copy native engine DLL to output when built -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\src\engine\native\x64\$(Configuration)\WhereIsIt.Engine.Native.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\engine\native\x64\$(Configuration)\WhereIsIt.Engine.Native.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WhereIsIt.Engine.Native.dll</Link>
    </None>
  </ItemGroup>
</Project>
