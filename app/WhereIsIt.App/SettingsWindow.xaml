<Window
    x:Class="WhereIsIt.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhereIsIt — Settings">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Index scope" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Comma-separated drive letters or paths to include in the index. Leave blank for all fixed volumes."/>
                    <TextBox Text="{x:Bind ViewModel.IndexScopeConfig, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="C:\, D:\Projects"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Global hotkey" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Use modifiers plus one key to bring WhereIsIt to the foreground."/>
                    <TextBox Text="{x:Bind ViewModel.GlobalHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Ctrl+Alt+W"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Startup" FontWeight="SemiBold"/>
                    <CheckBox Content="Start WhereIsIt when I sign in to Windows"
                              IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Local HTTP search server" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Optional JSON search endpoint. It listens on 127.0.0.1 only and is never exposed to the network."/>
                    <CheckBox Content="Enable localhost HTTP search server"
                              IsChecked="{x:Bind ViewModel.EnableHttpServer, Mode=TwoWay}"/>
                    <TextBox Header="Port" InputScope="Number" MaxLength="5"
                             Text="{x:Bind ViewModel.HttpServerPortConfig, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.Saved, Mode=OneWay}"
                     Severity="Success"
                     Title="Settings saved"
                     Message="Restart WhereIsIt to apply index, hotkey, or HTTP server changes."
                     IsClosable="False"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay}"
                     Severity="Error"
                     Title="Check your settings"
                     Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                     IsClosable="False"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"/>
                <Button Content="Close" Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
