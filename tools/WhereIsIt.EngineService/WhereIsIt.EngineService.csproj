<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WhereIsIt.EngineService</AssemblyName>
    <RootNamespace>WhereIsIt.EngineService</RootNamespace>
    <!-- Authored without a local build; don't fail the solution over a warning. -->
